# Copy this file to .env.local and fill in your values
# Variables prefixed with VITE_ are exposed to the browser
# Variables without VITE_ prefix are server-side only

# Optional: direct Gemini local testing. Vite variables are exposed to the browser.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-flash-latest

# Optional: backend API endpoint, if you build a secure server proxy.
VITE_API_BASE_URL=
